        // Absolute Fallback
        const finalUrl = urlLink ? (textStr + "\n" + urlLink) : textStr;
        window.open(`https://wa.me/?text=${encodeURIComponent(finalUrl)}`);
    }

    if(btnObj) btnObj.innerHTML = originalText;
}

