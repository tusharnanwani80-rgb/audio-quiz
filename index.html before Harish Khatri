/* Base Card Style */
.card { background: var(--white); border: 3px solid var(--dark); border-radius: 24px; padding: 32px 28px; box-shadow: 8px 8px 0px var(--dark); text-align: center; position: relative; overflow: hidden; }
.card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: linear-gradient(90deg, var(--blue), var(--pink), var(--orange), var(--lime)); z-index: 20; }

.logo { width: 72px; height: 72px; object-fit: contain; border-radius: 50%; border: 3px solid var(--dark); box-shadow: 3px 3px 0 var(--dark); margin-bottom: 14px; display: block; margin-left: auto; margin-right: auto; }

/* ===== Free-for-everyone credit banner (replaces TTC logo) ===== */
.credit{--cp:#FF4FB3;--cb:#1D3FC4;--cr:#FF3B2F;position:relative;display:flex;align-items:center;width:100%;max-width:330px;min-height:150px;margin:0 auto 16px;padding:12px 12px 12px 84px;background:#FFFDF8;border:3px solid var(--dark);border-radius:18px;box-shadow:4px 4px 0 var(--dark);overflow:hidden;text-align:left}
.credit i{position:absolute;display:block;pointer-events:none}
.credit .s-circ{left:-20px;top:-16px;width:112px;height:112px;border-radius:50%;background:var(--cp);opacity:.85;animation:crFloat 7s ease-in-out infinite}
.credit .s-tri{right:22px;top:10px;width:16px;height:24px;background:var(--cb);clip-path:polygon(100% 0,0 100%,65% 100%);animation:crSpin 9s ease-in-out infinite}
.credit .s-wedge{right:-10px;bottom:-4px;width:96px;height:34px;background:linear-gradient(90deg,rgba(255,59,47,0),var(--cr));clip-path:polygon(0 100%,100% 0,100% 100%);opacity:.55;animation:crFloat 8s ease-in-out infinite reverse}
.credit .s-bar{left:72px;bottom:16px;width:30px;height:5px;border-radius:3px;background:var(--cb);transform:rotate(-14deg);animation:crFloat 6s ease-in-out infinite}
.credit .s-dot{width:7px;height:7px;border-radius:50%}
.credit .d1{right:60px;bottom:14px;background:var(--cp);animation:crFloat 5s ease-in-out infinite}
.credit .d2{right:14px;top:46px;background:var(--cb);animation:crFloat 6.5s ease-in-out infinite reverse}
.cr-grain{position:absolute;inset:-20px;pointer-events:none;mix-blend-mode:multiply;opacity:.32;background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .25 0 0 0 0 .2 0 0 0 0 .15 0 0 0 .9 -.3'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");animation:crGrain .9s steps(4) infinite}
.cr-char{position:absolute;left:10px;bottom:0;width:66px;height:calc(100% - 8px);background:url(data:image/webp;base64,) no-repeat center bottom/contain;animation:crBob 4.5s ease-in-out infinite;filter:drop-shadow(2px 2px 0 rgba(45,42,38,.18))}
.cr-txt{position:relative;z-index:2}
.cr-free{font-family:'Nunito',sans-serif;font-weight:800;font-size:13px;line-height:1.25;color:var(--dark)}
.cr-free b{background:linear-gradient(transparent 58%,rgba(255,79,179,.45) 58%);padding:0 2px}
.cr-by{margin-top:8px;font-family:'Nunito',sans-serif;font-weight:900;font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--cr)}
.cr-name{font-family:'Fredoka One','Righteous',cursive;font-size:18px;line-height:1.12;color:var(--cb)}
.credit.mini{min-height:62px;margin-bottom:12px;padding:8px 10px 8px 56px;border-width:2.5px;border-radius:14px;box-shadow:3px 3px 0 var(--dark)}
.credit.mini .s-circ{left:-14px;top:-14px;width:64px;height:64px}
.credit.mini .s-bar,.credit.mini .s-wedge,.credit.mini .d2{display:none}
.credit.mini .cr-char{left:6px;top:4px;bottom:auto;width:42px;height:calc(100% - 4px);background-size:cover;background-position:50% 6%}
.credit.mini .cr-free{font-size:11px;line-height:1.2}
.credit.mini .cr-by{display:none}
.credit.mini .cr-name{font-size:13.5px;margin-top:1px}
@keyframes crFloat{0%,100%{transform:translate(0,0)}50%{transform:translate(3px,-5px)}}
