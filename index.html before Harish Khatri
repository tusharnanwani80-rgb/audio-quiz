<!DOCTYPE html>
<html lang="en" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TTC Admin | Quiz Generator</title>
    <meta name="google" content="notranslate">
    
    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#4361EE">
    <link rel="apple-touch-icon" href="icon-quizgen.png">
    
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Righteous&display=swap" rel="stylesheet">
    <style>
        :root {
            --blue:   #4361EE;
            --lime:   #C8FF00;
            --pink:   #FF3D8A;
            --dark:   #111118;
            --grey:   #6B6B80;
            --off:    #F5F4FF;
            --white:  #FFFFFF;
            --green:  #25D366;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--off);
            background-image: repeating-linear-gradient(-45deg, transparent, transparent 18px, rgba(67,97,238,0.045) 18px, rgba(67,97,238,0.045) 19px);
            color: var(--dark);
            margin: 0;
            padding: 50px 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 900px;
            width: 100%;
            background: var(--white);
            border: 3px solid var(--dark);
            box-shadow: 8px 8px 0px var(--dark);
            padding: 40px;
            border-radius: 24px;
            position: relative;
        }

        /* Top Accent Line */
        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: linear-gradient(90deg, var(--blue), var(--pink), var(--lime));
            z-index: 20;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
        }

        .header {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 30px;
            padding-bottom: 25px;
            border-bottom: 3px dashed rgba(17, 17, 24, 0.15);
            position: relative;
        }

        .logo {
            width: 65px;
            height: 65px;
            object-fit: contain;
            border-radius: 50%;
            border: 3px solid var(--dark);
            box-shadow: 3px 3px 0 var(--dark);
            background: var(--white);
        }

        .header-text h1 {
            margin: 0;
            font-family: 'Righteous', sans-serif;
            font-size: 32px;
            color: var(--dark);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .header-text p {
            margin: 4px 0 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--grey);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        /* Settings Icon */
        .settings-btn {
            background-color: var(--white);
            color: var(--dark);
            border: 3px solid var(--dark);
            box-shadow: 3px 3px 0 var(--dark);
            width: 45px;
            height: 45px;
            border-radius: 50%;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.1s;
            margin-left: auto;
        }
        .settings-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0 var(--blue);
            border-color: var(--blue);
        }
        .settings-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0 var(--blue);
        }

        /* Fixed Mobile Layout: Stacked vertically full width */
        .input-grid {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 25px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .flex-label {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        label {
            font-weight: 800;
            font-size: 14px;
            color: var(--dark);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0;
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 14px 16px;
            border: 2.5px solid var(--dark);
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            font-weight: 600;
            color: var(--dark);
            background: var(--off);
            box-sizing: border-box;
            box-shadow: 3px 3px 0 rgba(17, 17, 24, 0.1);
            transition: all 0.2s ease;
        }

        input[type="text"]:focus, textarea:focus {
            outline: none;
            background: var(--white);
            border-color: var(--blue);
            box-shadow: 4px 4px 0 var(--blue);
            transform: translate(-1px, -1px);
        }

        input[type="text"]::placeholder, textarea::placeholder {
            color: #A0A0B0;
            font-weight: 500;
        }

        .main-textarea {
            height: 450px;
            resize: vertical;
            white-space: pre-wrap;
            font-family: 'Courier New', Courier, monospace;
            font-size: 14px;
            line-height: 1.5;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 18px;
            margin-top: 30px;
            background-color: var(--lime);
            color: var(--dark);
            border: 3px solid var(--dark);
            box-shadow: 5px 5px 0 var(--dark);
            font-family: 'DM Sans', sans-serif;
            font-size: 18px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            border-radius: 14px;
            transition: transform 0.1s, box-shadow 0.1s;
        }

        .btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 7px 7px 0 var(--dark);
        }

        .btn:active {
            transform: translate(3px, 3px);
            box-shadow: 2px 2px 0 var(--dark);
            background-color: #B5E600;
        }

        .prompt-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .btn-sm {
            background-color: var(--white);
            color: var(--dark);
            border: 2px solid var(--dark);
            box-shadow: 3px 3px 0 var(--dark);
            padding: 6px 12px;
            border-radius: 8px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 800;
            font-size: 11px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.1s;
        }

        .btn-sm:hover {
            transform: translate(-1px, -1px);
            box-shadow: 4px 4px 0 var(--blue);
            border-color: var(--blue);
            color: var(--blue);
        }

        .btn-sm:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0 var(--blue);
        }

        /* Settings Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(17, 17, 24, 0.7);
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            backdrop-filter: blur(3px);
        }

        .modal-content {
            background: var(--white);
            border: 3px solid var(--dark);
            box-shadow: 8px 8px 0 var(--dark);
            border-radius: 20px;
            padding: 30px;
            width: 100%;
            max-width: 500px;
            position: relative;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-content h2 {
            margin-top: 0;
            font-family: 'Righteous', sans-serif;
            text-transform: uppercase;
            margin-bottom: 20px;
            color: var(--dark);
            font-size: 22px;
        }

        .close-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            background: transparent;
            border: none;
            font-size: 18px;
            cursor: pointer;
            transition: transform 0.1s;
        }

        .close-btn:hover { transform: scale(1.1); }

        .status {
            margin-top: 20px;
            font-weight: 800;
            font-size: 15px;
            text-align: center;
            padding: 12px;
            border-radius: 8px;
        }
        
        .error { 
            color: #D92D20; 
            background: #FEF3F2;
            border: 2px solid #F04438;
            display: block;
        }
        .success { 
            color: #039855; 
            background: #ECFDF3;
            border: 2px solid #12B76A;
            display: block;
        }

        @media (max-width: 600px) {
            .prompt-buttons { justify-content: flex-start; margin-top: 8px; width: 100%; }
            .flex-label { flex-direction: column; align-items: flex-start; }
            .btn-sm { width: 100%; text-align: center; }
        }

        /* ── Audio Studio ── */
        .audio-accordion-toggle {
            background-color: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }
        .audio-accordion-toggle:hover {
            background-color: #2a4bcc;
            box-shadow: 4px 4px 0 var(--dark);
            color: #fff;
        }
        .mic-btn {
            background-color: var(--white);
            color: var(--dark);
            border-color: var(--dark);
            position: relative;
        }
        .mic-btn.recording {
            background-color: var(--pink);
            color: #fff;
            border-color: var(--pink);
            animation: micPulse 1s ease-in-out infinite;
        }
        @keyframes micPulse {
            0%, 100% { box-shadow: 3px 3px 0 var(--pink); }
            50%       { box-shadow: 3px 3px 0 var(--pink), 0 0 0 5px rgba(255, 61, 138, 0.25); }
        }
        .audio-accordion-panel {
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        /* ── Instagram-Style Audio Trimmer ── */
        .trim-range-input {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            pointer-events: none;
            margin: 0;
            outline: none;
            z-index: 5;
        }
        .trim-range-input::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 28px;
            height: 60px;
            background: transparent;
            cursor: ew-resize;
            pointer-events: auto;
        }
        .trim-range-input::-moz-range-thumb {
            width: 28px;
            height: 60px;
            background: transparent;
            cursor: ew-resize;
            pointer-events: auto;
            border: none;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <img src="https://iili.io/CHHuZ6g.md.png" alt="TTC Logo" class="logo">
        <div class="header-text">
            <h1>TTC Quiz Generator</h1>
            <p>Godmode Admin Dashboard</p>
        </div>
        <!-- The Settings Gear -->
        <button class="settings-btn" onclick="openSettings()" title="Cloudinary Settings">⚙️</button>
    </div>
    
    <div class="input-grid">
        <div class="input-group">
            <label>Class (e.g., Class 9th CBSE)</label>
            <input type="text" id="classInput" placeholder="Class 9th CBSE">
        </div>
        <div class="input-group">
            <label>Subject (e.g., English)</label>
            <input type="text" id="subjectInput" placeholder="English">
        </div>
        <div class="input-group">
            <label>Chapter / Topic</label>
            <input type="text" id="chapterInput" placeholder="White Horses">
        </div>
    </div>

    <div class="input-group">
        <div class="flex-label">
            <label>Raw Quiz Data</label>
            <div class="prompt-buttons">
                <button id="copyPromptBtn" class="btn-sm" onclick="copyAiPrompt()">📝 Text Quiz Prompt</button>
                <button id="copyDiagramPromptBtn" class="btn-sm" onclick="copyDiagramPrompt()">🖼️ Diagram Prompt</button>
                <!-- NEW AUDIO PROMPT BUTTON -->
                <button id="copyAudioPromptBtn" class="btn-sm" onclick="copyAudioPrompt()">🎵 Audio Prompt</button>
            </div>
        </div>
        <textarea id="quizDataInput" class="main-textarea" placeholder="Question 1&#10;What is the full form of TTC?&#10;A) The Tuition Classes&#10;B) Total Teaching Center&#10;C) Tushar Tuition Classes&#10;D) Tushar Training Center&#10;Correct answer:&#10;Tushar Tuition Classes&#10;Explanation:&#10;As per your specific instruction..."></textarea>
    </div>

    <button class="btn" onclick="generateQuiz()">⚡ Create & Download HTML File</button>
    <div id="statusMessage" class="status"></div>
</div>

<!-- ========================================== -->
<!-- SETTINGS MODAL                             -->
<!-- ========================================== -->
<div id="settingsModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <button class="close-btn" onclick="closeSettings()">❌</button>
        <h2>Cloudinary Settings</h2>
        <div class="input-group" style="margin-bottom: 18px;">
            <label>Cloud Name</label>
            <input type="text" id="cloudName" placeholder="e.g., dtushartc">
        </div>
        <div class="input-group">
            <label>Upload Preset (Unsigned)</label>
            <input type="text" id="cloudPreset" placeholder="e.g., ttc_quizzes">
        </div>
        <button class="btn" style="padding: 14px; margin-top: 24px; font-size: 16px; background-color: var(--blue); color: var(--white);" onclick="saveSettings()">Save Credentials</button>
    </div>
</div>

<!-- ========================================== -->
<!-- MEDIA UPLOAD MODAL (INTERCEPTOR DOCK)      -->
<!-- ========================================== -->
<div id="imageModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <button class="close-btn" onclick="closeImageModal()">❌</button>
        <h2 style="color: var(--orange);" id="modalTitle">⚠️ Media Required</h2>
        <p id="imageModalDesc" style="font-weight: 700; color: var(--grey); margin-bottom: 15px; font-size: 14px;">Your quiz requires images or audio. Click a slot or press CTRL+V (for images) to instantly upload.</p>
        <div id="imageSlotsContainer" style="display:flex; flex-direction: column; gap: 15px; margin-top: 10px;">
            <!-- Slots dynamically injected here -->
        </div>
        <button id="finalizeBtn" class="btn" style="background-color: var(--lime); display:none; margin-top: 25px;" onclick="finalizeQuizWithImages()">✅ Finalize & Download</button>
    </div>
</div>

<!-- ========================================== -->
<!-- MASTER TEMPLATE (HIDDEN)                   -->
<!-- ========================================== -->
