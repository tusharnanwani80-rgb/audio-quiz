<script>
/* Change these two per quiz: */
const TTC_QUIZ={no:'सबकु 16',sub:'Singular, Plural & Gender'};

const TTCIntro=(()=>{
 const $=s=>document.querySelector(s),A=$('#vo'),B=$('#bgm'),ov=$('#ttcIntro'),stg=$('#stg'),gate=$('#gate');
 const SC=[...stg.querySelectorAll('.sc')],TS=[...stg.querySelectorAll('[data-t]')],HS=[...stg.querySelectorAll('[data-h]')];
 const BEATS=[0,1.18,1.95,3.75,4.35,4.95,5.3,6.17,6.8,7.3,7.85,8.35,8.8,9.88],END=12.6,AUD=11.16;
 let raf,tEnd=0,last=-1,onEnd=null,done=true;
 $('#qno').textContent=TTC_QUIZ.no;$('#qsub').textContent=TTC_QUIZ.sub;$('#gchip').textContent=TTC_QUIZ.no;$('#gch').textContent=TTC_QUIZ.sub;
 const clock=()=>A.ended?AUD+(performance.now()-tEnd)/1000:A.currentTime;
 function fit(){stg.style.transform='scale('+Math.min(innerWidth/360,innerHeight/640)+')'}
 addEventListener('resize',fit);fit();
 A.onended=()=>{tEnd=performance.now()};
 function tick(){
  const t=clock();
  SC.forEach(s=>{const on=t>=+s.dataset.s&&t<+s.dataset.e;s.classList.toggle('on',on);if(on)ov.style.background=s.dataset.bg});
  TS.forEach(e=>e.classList.toggle('in',t>=+e.dataset.t));
  HS.forEach(e=>e.classList.toggle('hi',t>=+e.dataset.h&&t<(+e.dataset.x||1e9)));
  let b=-1;BEATS.forEach((x,i)=>{if(t>=x)b=i});
  if(b!==last&&b>=0){last=b;stg.classList.remove('sh');void stg.offsetWidth;stg.classList.add('sh')}
  $('#bar').style.width=Math.min(100,t/END*100)+'%';
  if(t>=END)return finish();
  raf=requestAnimationFrame(tick);
 }
 function run(){
  done=false;last=-1;cancelAnimationFrame(raf);A.currentTime=0;B.currentTime=0;
  B.play().catch(()=>{});
  A.play().then(()=>{gate.hidden=true;raf=requestAnimationFrame(tick)}).catch(()=>{B.pause();gate.hidden=false});
 }
 function finish(){
  if(done)return;done=true;cancelAnimationFrame(raf);A.pause();B.pause();ov.classList.add('out');
  setTimeout(()=>{ov.hidden=true;onEnd&&onEnd()},350);
 }
 $('#gbtn').onclick=run;
 return{
  play(cb){onEnd=cb;ov.hidden=false;ov.classList.remove('out');gate.hidden=true;run()},
  skip:finish,
  replayGate(){ov.hidden=false;ov.classList.remove('out');$('#gbl').textContent='Replay';gate.hidden=false}
 };
})();

/* Standalone: plays on load, then calls your quiz's launchQuiz() if it exists. */
TTCIntro.play(()=>{try{parent.launchQuiz()}catch(e){TTCIntro.replayGate()}});
<\/script>
