                fileInput.addEventListener('change', (e) => uploadToCloudinary(e.target.files[0], index));

                const uploadBtn = document.createElement('button');
                uploadBtn.className = 'btn-sm';
                uploadBtn.innerHTML = mediaObj.type === 'audio' ? '🎵 Upload Audio' : '📤 Upload Image';
                uploadBtn.onclick = () => fileInput.click();

                const statusSpan = document.createElement('span');
                statusSpan.id = `uploadStatus_${index}`;
                statusSpan.style.fontSize = '12px';
                statusSpan.style.fontWeight = '800';

                // --- MIC BUTTON (only for audio slots) ---
                if (mediaObj.type === 'audio') {
                    const micBtn = document.createElement('button');
                    micBtn.className = 'btn-sm mic-btn';
                    micBtn.id = `micBtn_${index}`;
                    micBtn.title = 'Record via Microphone';
                    micBtn.innerHTML = '🎙️ Mic';
                    micBtn.onclick = () => startMicRecording(index);

                    const ncLabel = document.createElement('label');
                    ncLabel.style.cssText = 'font-size:11px; font-weight:700; display:flex; align-items:center; gap:4px; cursor:pointer; color:var(--dark); margin-left:4px;';
                    ncLabel.title = 'Toggle AI noise cancellation (turn off if it cuts out quiet sounds)';
                    ncLabel.innerHTML = `<input type="checkbox" id="noiseCancel_${index}" checked style="accent-color:var(--blue);cursor:pointer;"> AI Clean`;

                    actionRow.appendChild(fileInput);
                    actionRow.appendChild(uploadBtn);
                    actionRow.appendChild(micBtn);
                    actionRow.appendChild(ncLabel);
                    actionRow.appendChild(statusSpan);
                } else {
                    actionRow.appendChild(fileInput);
                    actionRow.appendChild(uploadBtn);
                    actionRow.appendChild(statusSpan);
                }
            }


            slot.appendChild(title);
            slot.appendChild(actionRow);
            container.appendChild(slot);
        });

        checkAllUploaded();
    }

    async function uploadToCloudinary(file, index) {
        if(!file) return;
        
        const cloudName = localStorage.getItem('ttc_cloudName');
        const preset = localStorage.getItem('ttc_cloudPreset');
        const statusSpan = document.getElementById(`uploadStatus_${index}`);
        const mediaType = pendingMedia[index].type;
        
        statusSpan.innerText = '🔄 Uploading...';
        statusSpan.style.color = 'var(--blue)';

        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', preset);

        // Cloudinary requires /video/upload for audio files
        const endpointType = mediaType === 'audio' ? 'video' : 'image';

        try {
            const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/${endpointType}/upload`, {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            
            if(data.secure_url) {
                let url = data.secure_url;
                const uploadStr = '/upload/';
                if (mediaType === 'image' && url.includes(uploadStr)) {
                    // Inject compression and format directly into the URL returned by Cloudinary (Images only)
                    url = url.replace(uploadStr, uploadStr + 'c_limit,w_800,q_auto,f_jpg/');
                }
                pendingMedia[index].url = url;
                renderMediaSlots();
            } else {
                throw new Error(data.error?.message || 'Upload failed');
            }
        } catch (err) {
            statusSpan.innerText = `❌ Error: ${err.message}`;
            statusSpan.style.color = 'red';
        }
    }

    function resetSlot(index) {
        pendingMedia[index].url = null;
        renderMediaSlots();
    }

    function checkAllUploaded() {
        const allDone = pendingMedia.every(media => media.url !== null);
        const finalizeBtn = document.getElementById('finalizeBtn');
        finalizeBtn.style.display = (allDone && pendingMedia.length > 0) ? 'block' : 'none';
    }

    function closeImageModal() {
        document.getElementById('imageModal').style.display = 'none';
    }

    function finalizeQuizWithImages() {
        let finalRawData = rawDataSnapshot;
        
        // Loop through and swap original tags with HTML img/audio tags
        pendingMedia.forEach(media => {
            let mediaHtml = '';
            if(media.type === 'image') {
                mediaHtml = `<img src="${media.url}" class="godmode-diagram" alt="Quiz Diagram">`;
            } else if (media.type === 'audio') {
                // Incorporating spacing around the audio player specifically for the quizzes 
                mediaHtml = `<div class="question-has-audio"><audio controls src="${media.url}" class="godmode-audio"></audio></div>`;
            }
            finalRawData = finalRawData.replace(media.originalTag, mediaHtml);
        });
        
        closeImageModal();
        
        const className = document.getElementById('classInput').value.trim();
        const subject = document.getElementById('subjectInput').value.trim();
        const chapter = document.getElementById('chapterInput').value.trim();
        const status = document.getElementById('statusMessage');
        
        processAndDownload(finalRawData, className, subject, chapter, status);
    }

    // --- GODMODE PASTE LISTENER FOR IMAGES ---
    document.addEventListener('paste', (e) => {
        // Only trigger if the Media Upload Modal is currently visible
        if (document.getElementById('imageModal').style.display === 'flex') {
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            for (let index in items) {
                const item = items[index];
                if (item.kind === 'file' && item.type.includes('image/')) {
                    const blob = item.getAsFile();
                    // Find the very first empty IMAGE slot to populate
                    const firstEmptyIdx = pendingMedia.findIndex(media => media.url === null && media.type === 'image');
                    if(firstEmptyIdx !== -1) {
                        uploadToCloudinary(blob, firstEmptyIdx);
                    }
                    break;
                }
            }
        }
    });

    // --- PARSING & DOWNLOADING ---
    function processAndDownload(dataText, className, subject, chapter, status) {
        try {
            const questions = parseRawData(dataText);
            
            if (questions.length === 0) {
                throw new Error("Could not detect any questions. Please check your formatting.");
            }

            let templateStr = document.getElementById('master-template').value;
            
            templateStr = templateStr.replace(/\{\{GEN_CHAPTER\}\}/g, () => chapter);
            templateStr = templateStr.replace(/\{\{GEN_CLASS\}\}/g, () => className);
            templateStr = templateStr.replace(/\{\{GEN_SUBJECT\}\}/g, () => subject);
            templateStr = templateStr.replace(/\{\{GEN_QCOUNT\}\}/g, () => questions.length);

            // Safely encode JSON by swapping angle brackets to unicode, guaranteeing no parser breaks
            const jsonStr = JSON.stringify(questions, null, 4).replace(/</g, '\\u003c');
            templateStr = templateStr.replace(/\{\{GEN_QUIZDATA\}\}/g, () => jsonStr);

            downloadFile(className, subject, chapter, templateStr);
            
            status.innerHTML = `<span class="success">✅ Boom! Generated ${questions.length} questions and downloaded the file instantly.</span>`;
            
            document.getElementById('quizDataInput').value = '';
            
        } catch (error) {
            status.innerHTML = `<span class="error">⚠️ Error: ${error.message}</span>`;
        }
    }

    function parseRawData(text) {
        const blocks = text.split(/Question\s+\d+/i).filter(b => b.trim().length > 0);
        const parsedData = [];

        blocks.forEach((block, index) => {
            const qMatch = block.match(/([\s\S]*?)A\)/);
            const aMatch = block.match(/A\)([\s\S]*?)B\)/);
            const bMatch = block.match(/B\)([\s\S]*?)C\)/);
            const cMatch = block.match(/C\)([\s\S]*?)D\)/);
            const dMatch = block.match(/D\)([\s\S]*?)Correct answer:/i);
            const ansMatch = block.match(/Correct answer:([\s\S]*?)Explanation:/i);
            const expMatch = block.match(/Explanation:([\s\S]*)$/i);

            if (!qMatch || !aMatch || !bMatch || !cMatch || !dMatch || !ansMatch || !expMatch) {
                throw new Error(`Formatting issue found around Question ${index + 1}. Please ensure it exactly matches the structure.`);
            }

            parsedData.push({
                question: qMatch[1].trim(),
                options: [
                    aMatch[1].trim(),
                    bMatch[1].trim(),
                    cMatch[1].trim(),
                    dMatch[1].trim()
                ],
                correct: ansMatch[1].trim(),
                explanation: expMatch[1].trim()
            });
        });

        return parsedData;
    }

    function downloadFile(className, subject, chapter, content) {
        const safeName = `${className}-${subject}-${chapter}`
            .replace(/[^a-zA-Z0-9]/g, '-')
            .replace(/-+/g, '-')
            .toLowerCase();
            
        const fileName = `${safeName}.html`;
        
        // EXPLICIT UTF-8 ENCODING: Fixes Font parsing errors on mobile Android browsers
        const blob = new Blob([content], { type: 'text/html;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    // ══════════════════════════════════════════════════
    // AUDIO STUDIO — Trim, Auto-play on drag, Apply-All
    // ══════════════════════════════════════════════════

    /** Toggle accordion open / closed */
    function toggleAudioAccordion(accordionId) {
        const panel = document.getElementById(accordionId);
        if (!panel) return;
        panel.style.display = panel.style.display !== 'none' ? 'none' : 'block';
    }

    /** Format seconds → m:ss */
    function _fmtTime(sec) {
        sec = Math.max(0, sec);
        return `${Math.floor(sec / 60)}:${Math.floor(sec % 60).toString().padStart(2, '0')}`;
    }

    /** Update the visual trimmer UI (dim overlays and selection box) */
    function _updateTrimUI(index, startSec, endSec, audioDur) {
        if (audioDur <= 0) return;
        const leftPct = (startSec / audioDur) * 100;
        const rightPct = 100 - ((endSec / audioDur) * 100);
        const widthPct = ((endSec - startSec) / audioDur) * 100;

        const dimLeft = document.getElementById(`dimLeft_${index}`);
        const dimRight = document.getElementById(`dimRight_${index}`);
        const trimBox = document.getElementById(`trimBox_${index}`);
        
        if (dimLeft) dimLeft.style.width = `${leftPct}%`;
        if (dimRight) dimRight.style.width = `${rightPct}%`;
        if (trimBox) {
            trimBox.style.left = `${leftPct}%`;
            trimBox.style.width = `${widthPct}%`;
        }
    }

    /**
     * Called when either handle is dragged.
     * - Enforces start < end
     * - Auto-plays from the start point so you can hear the selection
     */
    function onTrimChange(index, type, value, audioId) {
        const startSldr = document.getElementById(`trimStart_${index}`);
        const endSldr   = document.getElementById(`trimEnd_${index}`);
        const startLbl  = document.getElementById(`startLbl_${index}`);
        const endLbl    = document.getElementById(`endLbl_${index}`);
        if (!startSldr || !endSldr) return;

        let startSec = parseFloat(startSldr.value);
        let endSec   = parseFloat(endSldr.value);
        const maxDur = parseFloat(endSldr.max) || 0;

        // Keep a minimum gap between the two handles
        const minGap = 0.5;
        if (type === 'start' && startSec >= endSec - minGap) {
            startSec = Math.max(0, endSec - minGap);
            startSldr.value = startSec;
        }
        if (type === 'end' && endSec <= startSec + minGap) {
            endSec = Math.min(maxDur, startSec + minGap);
            endSldr.value = endSec;
        }

        if (startLbl) startLbl.innerText = _fmtTime(startSec);
        if (endLbl)   endLbl.innerText   = _fmtTime(endSec);
        
        _updateTrimUI(index, startSec, endSec, maxDur);

        // Always play from the start point (as requested by user)
        const audio = document.getElementById(audioId);
        if (!audio) return;
        clearTimeout(audio._autoTrimTimer);
        
        audio.currentTime = startSec;
        audio.play().catch(() => {});
        
        // Stop playing after the selected duration
        const playDur = endSec - startSec;
        audio._autoTrimTimer = setTimeout(() => audio.pause(), playDur * 1000);
    }

    /** 
     * Nudge trim slider by an exact amount (for surgical editing)
     */
    function nudgeTrim(index, type, amount, audioId) {
        const sldr = document.getElementById(type === 'start' ? `trimStart_${index}` : `trimEnd_${index}`);
        if (!sldr) return;
        let val = parseFloat(sldr.value) + amount;
        val = Math.max(parseFloat(sldr.min) || 0, Math.min(parseFloat(sldr.max) || 0, val));
        sldr.value = val;
        onTrimChange(index, type, val, audioId);
    }

    /** Play the selected trim region in full */
    function previewTrimSlot(index, audioId) {
        const startSldr = document.getElementById(`trimStart_${index}`);
        const endSldr   = document.getElementById(`trimEnd_${index}`);
        const audio     = document.getElementById(audioId);
        if (!audio || !startSldr || !endSldr) return;
        const startSec = parseFloat(startSldr.value) || 0;
        const endSec   = parseFloat(endSldr.value)   || audio.duration;
        clearTimeout(audio._autoTrimTimer);
        audio.currentTime = startSec;
        audio.play().catch(() => {});
        audio._autoTrimTimer = setTimeout(() => { audio.pause(); audio.currentTime = startSec; }, Math.max(200, (endSec - startSec) * 1000));
    }

    /** Decode → trim → WAV → upload to Cloudinary */
    async function applyTrimAndUpload(slotIndex, statusSpanId) {
        const statusSpan = document.getElementById(statusSpanId);
        const startSldr  = document.getElementById(`trimStart_${slotIndex}`);
        const endSldr    = document.getElementById(`trimEnd_${slotIndex}`);
        if (!statusSpan || !startSldr || !endSldr) return;

        const startSec = parseFloat(startSldr.value) || 0;
        const endSec   = parseFloat(endSldr.value);
        if (isNaN(endSec) || endSec <= startSec) {
            statusSpan.innerText = '⚠️ Move the End (⏹) slider past Start (▶)';
            statusSpan.style.color = 'red';
            return;
        }

        statusSpan.innerText = '⏳ Trimming & uploading…';
        statusSpan.style.color = 'var(--blue)';

        try {
            const resp     = await fetch(pendingMedia[slotIndex].url);
            const arrayBuf = await resp.arrayBuffer();
            const octx     = new (window.OfflineAudioContext || window.webkitOfflineAudioContext)(2, 44100 * 300, 44100);
            const decoded  = await new Promise((res, rej) => octx.decodeAudioData(arrayBuf.slice(0), res, rej));
            const sr       = decoded.sampleRate;
            const ch       = decoded.numberOfChannels;
            const s0       = Math.floor(startSec * sr);
            const s1       = Math.min(Math.ceil(endSec * sr), decoded.length);
            const len      = s1 - s0;
            if (len <= 0) throw new Error('Trim region is empty.');
            const buf = new OfflineAudioContext(ch, len, sr).createBuffer(ch, len, sr);
            for (let c = 0; c < ch; c++) buf.getChannelData(c).set(decoded.getChannelData(c).subarray(s0, s1));
            const wavBlob  = audioBufferToWavBlob(buf);
            const formData = new FormData();
            formData.append('file', wavBlob, 'trimmed.wav');
            formData.append('upload_preset', localStorage.getItem('ttc_cloudPreset'));
            const res  = await fetch(`https://api.cloudinary.com/v1_1/${localStorage.getItem('ttc_cloudName')}/video/upload`, { method: 'POST', body: formData });
            const data = await res.json();
            if (data.secure_url) {
                pendingMedia[slotIndex].url = data.secure_url;
                statusSpan.innerText = '✅ Done!';
                statusSpan.style.color = 'var(--green)';
                setTimeout(() => renderMediaSlots(), 1200);
            } else throw new Error(data.error?.message || 'Upload failed');
        } catch (err) {
            statusSpan.innerText = `❌ ${err.message}`;
            statusSpan.style.color = 'red';
        }
    }

    /**
     * Upload ONE audio file to Cloudinary once,
     * then set that URL on every audio slot.
     * Each slot can then be trimmed independently.
     */
    async function applyAudioToAllSlots(file) {
        if (!file) return;
        const audioIndices = pendingMedia.map((m, i) => m.type === 'audio' ? i : -1).filter(i => i >= 0);
        if (audioIndices.length === 0) return;
        const statusEl = document.getElementById('applyAllStatus');
        if (statusEl) { statusEl.innerText = '⏳ Uploading…'; statusEl.style.color = 'var(--blue)'; }
        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', localStorage.getItem('ttc_cloudPreset'));
        try {
            const res  = await fetch(`https://api.cloudinary.com/v1_1/${localStorage.getItem('ttc_cloudName')}/video/upload`, { method: 'POST', body: formData });
            const data = await res.json();
            if (data.secure_url) {
                audioIndices.forEach(i => { pendingMedia[i].url = data.secure_url; });
                renderMediaSlots();
            } else throw new Error(data.error?.message || 'Upload failed');
        } catch (err) {
            if (statusEl) { statusEl.innerText = `❌ ${err.message}`; statusEl.style.color = 'red'; }
        }
    }


    /** Encode an AudioBuffer to a WAV Blob (PCM 16-bit) */
    function audioBufferToWavBlob(buffer) {
        const numChannels = buffer.numberOfChannels;
        const sampleRate  = buffer.sampleRate;
        const numSamples  = buffer.length;
        const byteLength  = 44 + numSamples * numChannels * 2;
        const arrayBuf    = new ArrayBuffer(byteLength);
        const view        = new DataView(arrayBuf);

        function writeStr(offset, str) { for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i)); }
        writeStr(0, 'RIFF');
        view.setUint32(4, byteLength - 8, true);
        writeStr(8, 'WAVE');
        writeStr(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true); // PCM
        view.setUint16(22, numChannels, true);
        view.setUint32(24, sampleRate, true);
        view.setUint32(28, sampleRate * numChannels * 2, true);
        view.setUint16(32, numChannels * 2, true);
        view.setUint16(34, 16, true);
        writeStr(36, 'data');
        view.setUint32(40, numSamples * numChannels * 2, true);

        let offset = 44;
        for (let i = 0; i < numSamples; i++) {
            for (let c = 0; c < numChannels; c++) {
                const s = Math.max(-1, Math.min(1, buffer.getChannelData(c)[i]));
                view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
                offset += 2;
            }
        }
        return new Blob([arrayBuf], { type: 'audio/wav' });
    }

    // ── Microphone Recording State ──
    let _micRecorder = null;
    let _micChunks   = [];
    let _micStream   = null;
    let _micSlotIndex = -1;

    /** Start mic recording for a given slot */
    async function startMicRecording(slotIndex) {
        const micBtn = document.getElementById(`micBtn_${slotIndex}`);
        const statusSpan = document.getElementById(`uploadStatus_${slotIndex}`);
        const ncCheckbox = document.getElementById(`noiseCancel_${slotIndex}`);

        if (_micRecorder && _micRecorder.state === 'recording') {
            // Second tap = stop
            _micRecorder.stop();
            return;
        }

        try {
            const useNC = ncCheckbox ? ncCheckbox.checked : true;
            _micStream    = await navigator.mediaDevices.getUserMedia({ 
                audio: { 
                    noiseSuppression: useNC, 
                    echoCancellation: useNC, 
                    autoGainControl: useNC 
                } 
            });
            _micChunks    = [];
            _micSlotIndex = slotIndex;
            _micRecorder  = new MediaRecorder(_micStream);

            _micRecorder.ondataavailable = (e) => { if (e.data.size > 0) _micChunks.push(e.data); };

            _micRecorder.onstop = async () => {
                // Stop all mic tracks
                _micStream.getTracks().forEach(t => t.stop());
                const blob = new Blob(_micChunks, { type: 'audio/webm' });
                if (micBtn) { micBtn.innerHTML = '&#x1F399; Mic'; micBtn.style.background = ''; micBtn.style.color = ''; }
                if (statusSpan) { statusSpan.innerText = '🔄 Uploading recording…'; statusSpan.style.color = 'var(--blue)'; }
                await uploadToCloudinary(blob, _micSlotIndex);
                _micRecorder  = null;
                _micChunks    = [];
                _micStream    = null;
                _micSlotIndex = -1;
            };

            _micRecorder.start();
            if (micBtn) { micBtn.innerHTML = '&#x23F9; Stop'; micBtn.style.background = 'var(--pink)'; micBtn.style.color = '#fff'; }
            if (statusSpan) { statusSpan.innerText = '🔴 Recording…'; statusSpan.style.color = 'var(--pink)'; }
        } catch (err) {
            if (statusSpan) { statusSpan.innerText = `❌ Mic error: ${err.message}`; statusSpan.style.color = 'red'; }
        }
    }

