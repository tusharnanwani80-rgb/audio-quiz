.btn-blue   { background: var(--blue);  color: white; }
.btn-lime   { background: var(--lime);  color: var(--dark); }
.btn-pink   { background: var(--pink);  color: white; position: relative; overflow: hidden; }
.btn-green  { background: var(--green); color: white; }
.btn-ghost  { background: transparent; color: var(--grey); border-color: var(--light); box-shadow: 4px 4px 0 var(--light); }
.btn-ghost:hover { border-color: var(--dark); color: var(--dark); box-shadow: 4px 4px 0 var(--dark); }
.info-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 16px 0 22px; }
.info-pill { background: var(--off); border: 2px solid var(--dark); border-radius: 50px; padding: 5px 14px; font-size: 12px; font-weight: 700; color: var(--dark); box-shadow: 2px 2px 0 var(--dark); }
.progress-wrap { margin-bottom: 22px; }
.progress-meta { display: flex; justify-content: space-between; font-size: 12px; font-weight: 800; color: var(--dark); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.3px; }
.progress-track { height: 10px; background: var(--light); border-radius: 50px; border: 2px solid var(--dark); overflow: hidden; }
