function selectOption(el,opt,q){
  const qzCard = document.getElementById('quizCard');
  if (qzCard && qzCard.classList.contains('is-broken')) return;

  document.querySelectorAll(".option").forEach(o=>o.onclick=null);
  const isCorrect = opt===q.correct;
  answerLog.push({ questionNo: qIndex + 1, question: q.question, yourAnswer: opt, correct: q.correct, isCorrect: isCorrect, explanation: q.explanation || '' });
  
  if(isCorrect){ 
      el.classList.add("correct"); score++; streak++;
      if(document.getElementById('streakDisplayVal')) document.getElementById('streakDisplayVal').innerText = streak;
      
      confetti({particleCount:50,spread:60,origin:{y:0.6},colors:["#4361EE","#C8FF00","#FF3D8A","#25D366"]}); 
      
      const streakPill = document.getElementById('streakCounterPill');
      if (streakPill) {
          streakPill.classList.remove('score-bump');
          void streakPill.offsetWidth;
          streakPill.classList.add('score-bump');
      }

      // Bomb Escalation
      const bombWrapper = document.getElementById('bombWrapper');
      if(bombWrapper) {
          bombWrapper.classList.add('active');
          let newScale = 0.6 + (streak * 0.15);
          if (newScale > 3.2) newScale = 3.2; 
          bombWrapper.style.transform = `scale(${newScale})`;
      }

      if (qzCard) {
          let currentLevel = 0;
          if (streak >= 20) currentLevel = 20;
          else if (streak >= 15) currentLevel = 15;
          else if (streak >= 10) currentLevel = 10;
          else if (streak >= 5) currentLevel = 5;
          else if (streak >= 3) currentLevel = 3;

          const levels = [3, 5, 10, 15, 20];
          levels.forEach(l => {
              if (l !== currentLevel) qzCard.classList.remove('lvl-' + l);
          });
          if (currentLevel > 0) qzCard.classList.add('lvl-' + currentLevel);

          if (streak === 3 || (streak > 3 && streak % 5 === 0)) {
              playMilestoneChime(streak);
              if(document.getElementById('comboVal')) document.getElementById('comboVal').innerText = streak;
              
              qzCard.classList.remove('milestone-hit');
              void qzCard.offsetWidth;
              qzCard.classList.add('milestone-hit');

              clearTimeout(window.milestoneTimeout);
              window.milestoneTimeout = setTimeout(() => {
                  qzCard.classList.remove('milestone-hit');
              }, 2000);
          }
      }
  } else { 
      el.classList.add("wrong"); 
      document.querySelectorAll(".option").forEach(o=>{ if(o.querySelector(".opt-text")?.innerText.trim()===q.correct) o.classList.add("correct"); }); 
      wrongAnswers.push({question: q.question, yourAnswer: opt, correct: q.correct, explanation: q.explanation || ''}); 

      // Detonation logic
      if (streak >= 3 && qzCard) {
          qzCard.classList.add('is-broken');
          playDetonationSound();
          
          const blastLottie = document.getElementById('blastLottie');
          if(blastLottie && typeof blastLottie.play === 'function') {
              blastLottie.seek(0);
              blastLottie.play();
          }

          clearTimeout(window.breakTimeout);
          window.breakTimeout = setTimeout(() => {
              qzCard.classList.remove('is-broken');
              qzCard.classList.remove('lvl-3', 'lvl-5', 'lvl-10', 'lvl-15', 'lvl-20');
          }, 2000);
      }

      streak = 0;
      if(document.getElementById('streakDisplayVal')) document.getElementById('streakDisplayVal').innerText = streak;
      const bombWrapper = document.getElementById('bombWrapper');
      if(bombWrapper) {
          bombWrapper.classList.remove('active');
          bombWrapper.style.transform = `scale(0)`;
      }
  }
  document.getElementById("explText").innerHTML=q.explanation; document.getElementById("explBox").classList.add("show");
  document.getElementById("qScore").innerText=`Score: ${score}`; document.getElementById("nextBtn").classList.remove("hidden");
}
