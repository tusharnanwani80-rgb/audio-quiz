function sendToSheet(total, pct){
  if(!APPS_SCRIPT_URL || APPS_SCRIPT_URL === 'PASTE_YOUR_WEB_APP_URL_HERE' || APPS_SCRIPT_URL.includes('YOUR_APPS_SCRIPT_URL_HERE')) {
    console.warn("⚠️ Developer Alert: Web App URL missing.");
    return;
  }
 
  currentAttempt = 1;
  try {
    const attemptKey = 'ttc_att_' + subjectName + '_' + chapterName;
    currentAttempt = parseInt(localStorage.getItem(attemptKey) || '0') + 1;
    localStorage.setItem(attemptKey, currentAttempt);
  } catch(e) {}
 
  const payload = {
    name: username,
    subject: subjectName,
    chapter: chapterName,
    score: score,
    total: total,
    percentage: pct,
    timeTaken: Math.round((Date.now() - quizStartTime) / 1000),
    tabSwitches: tabSwitches,
    attempt: currentAttempt,
    questionsAttempted: answerLog.length,
    answerLog: answerLog,
    wrongAnswers: wrongAnswers,
    device: navigator.userAgent
  };
  
  if (challengeData) {
    payload.challengerName = challengeData.n;
    payload.challengerScore = challengeData.s;
    payload.didPlayerWin = score > challengeData.s;
  }
  
  fetch(APPS_SCRIPT_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(payload)
  }).catch(()=>{});
}

