async function createTtcQuizPdf(report, fileName){
  if (!window.jspdf || !window.jspdf.jsPDF) {
    alert('PDF maker is still loading. Please check your internet connection and try again.');
    return;
  }

  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'a4' });
  const pageW = doc.internal.pageSize.getWidth();
  const pageH = doc.internal.pageSize.getHeight();
  const colors = {
    page: '#EAF6F6', header: '#4A90E2',
    teal: '#207C78', tealDark: '#2F6FAF', tealSoft: '#DDF3EF',
    cream: '#FFF8EF', mustard: '#F7B84B', white: '#FFFFFF',
    ink: '#243447', body: '#64748B', line: '#E8DED2',
    green: '#2E8B57', red: '#D95B72',
    paleGreen: '#EAF8EF', paleRed: '#FFF0F4',
    blue: '#4361EE', muted: '#6B6B80'
  };
  const assets = await loadPdfAssets();
  const margin = 30;
  const panelW = pageW - margin*2;
  const bottomLimit = pageH - 40;
  let y = 0;

  // -- NATIVE UNICODE CANVAS OVERRIDE --
  let currentTextColor = '#243447';
  const origSetTextColor = doc.setTextColor.bind(doc);
  doc.setTextColor = function() {
    if(arguments.length===1 && typeof arguments[0]==='string') currentTextColor = arguments[0];
    return origSetTextColor.apply(this, arguments);
  };
  let currentFontWeight = 'normal';
  const origSetFont = doc.setFont.bind(doc);
  doc.setFont = function(fontName, fontStyle) {
    if(fontStyle) currentFontWeight = fontStyle;
    else if(fontName !== 'helvetica') currentFontWeight = fontName;
    else currentFontWeight = 'normal';
    return origSetFont.apply(this, arguments);
  };
  doc.getStringUnitWidth = function(text) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    const fs = doc.internal.getFontSize();
    ctx.font = `${currentFontWeight} ${fs}pt sans-serif`;
    return (ctx.measureText(text).width * 0.75) / fs;
  };
  const origText = doc.text.bind(doc);
  doc.text = function(text, x, yPos, options) {
    if (!text) return doc;
    const textArr = Array.isArray(text) ? text : [text];
    if (textArr.length === 0 || !textArr[0]) return doc;
    
    const fs = doc.internal.getFontSize();
    const pt2px = 1.3333;
    const pxFs = fs * pt2px;
    const pxLh = fs * 1.15 * pt2px;
    
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    const scale = 3; 
    
    ctx.font = `${currentFontWeight} ${pxFs}px sans-serif`;
    let maxW = 0;
    for(let t of textArr) {
      const w = ctx.measureText(t).width;
      if(w > maxW) maxW = w;
    }
    if (maxW === 0) return doc;
    
    const padX = 4 * pt2px;
    const padY = 4 * pt2px;
    
    canvas.width = (maxW + padX * 2) * scale;
    canvas.height = ((textArr.length - 1) * pxLh + pxFs * 1.4 + padY * 2) * scale;
    
    ctx.scale(scale, scale);
    ctx.font = `${currentFontWeight} ${pxFs}px sans-serif`;
    ctx.fillStyle = currentTextColor;
    ctx.textBaseline = 'top';
    
    for(let i=0; i<textArr.length; i++) {
      ctx.fillText(textArr[i], padX, padY + i * pxLh);
    }
    
    const ptW = (canvas.width / scale) * 0.75;
    const ptH = (canvas.height / scale) * 0.75;
    
    const imgY = yPos - fs - (padY * 0.75);
    const imgX = x - (padX * 0.75);
    
    try {
      doc.addImage(canvas.toDataURL('image/png'), 'PNG', imgX, imgY, ptW, ptH);
    } catch(e) { origText(text, x, yPos, options); }
    return doc;
  };
  // -------------------------------------

  function clean(value){ 
    return String(value ?? '')
      .replace(/<[^>]*>?/gm, '')
      .replace(/\s+/g, ' ')
      .trim(); 
  }
  function wrap(text, width, size, weight='normal'){ doc.setFont('helvetica', weight); doc.setFontSize(size); return doc.splitTextToSize(clean(text), width); }
  function withOpacity(opacity, draw){ let used=false; try{ doc.setGState(new doc.GState({ opacity })); used=true; }catch(e){} draw(); if(used){ try{ doc.setGState(new doc.GState({ opacity: 1 })); }catch(e){} } }
  function drawImageContain(asset, cx, cy, maxW, maxH){ 
    if(!asset || !asset.data) return; 
    const scale = Math.min(maxW / (asset.width || maxW), maxH / (asset.height || maxH)); 
    const w = (asset.width || maxW) * scale;
    const h = (asset.height || maxH) * scale; 
    try { doc.addImage(asset.data, asset.type, cx - w/2, cy - h/2, w, h); } catch(e){} 
  }
  function secondsToText(sec){ sec=parseInt(sec||0); return sec>=60 ? `${Math.floor(sec/60)}m ${sec%60}s` : `${sec}s`; }

  function pageBase(firstPage=false){
    const panelY = firstPage ? 118 : 38;
    const panelH = pageH - panelY - 50;
    doc.setFillColor(colors.page); doc.rect(0, 0, pageW, pageH, 'F');
    if (firstPage) { doc.setFillColor(colors.header); doc.rect(0, 0, pageW, 98, 'F'); }
    doc.setFillColor(colors.cream); doc.roundedRect(margin, panelY, panelW, panelH, 24, 24, 'F');
    if (firstPage) {
      if(assets.logo) drawImageContain(assets.logo, margin + 34, 49, 56, 86);
      doc.setTextColor(colors.white); doc.setFont('helvetica', 'bold'); doc.setFontSize(30); doc.text('Sindhi Quiz Results', 116, 48);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(13); doc.text('Vidarbha Sindhi Vikas Parishad, Wardha', 118, 70); doc.setFontSize(11); doc.text('Jai Jhulelal  |  Free for everyone', 118, 87);
      if(assets.sai) drawImageContain(assets.sai, pageW - margin - 44, 49, 72, 72);
    }
  }
  function drawFootersAndWatermark(){
    const pages = doc.internal.getNumberOfPages();
    for(let i=1;i<=pages;i++){
      doc.setPage(i);
      doc.setTextColor('#6E8398'); doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
      doc.text(`Page ${i} of ${pages}`, pageW - 92, pageH - 24);
      doc.text('Jai Jhulelal  |  Vidarbha Sindhi Vikas Parishad, Wardha', margin + 18, pageH - 30);
      doc.text('Free for everyone  |  Initiative by Tushar Sunderlal Nanwani', margin + 18, pageH - 17);
    }
  }
  function newPage(){ doc.addPage(); pageBase(false); y = 76; }
  function need(height){ if(y + height > bottomLimit) newPage(); }
  function statCard(label, value, x, statY, w){
    doc.setFillColor(colors.white); doc.roundedRect(x, statY, w, 70, 16, 16, 'F');
    doc.setTextColor(colors.teal); doc.setFont('helvetica', 'bold'); doc.setFontSize(11); doc.text(clean(label).toUpperCase(), x+18, statY+24);
    doc.setTextColor(colors.ink); doc.setFontSize(19); doc.text(wrap(value, w-36, 19, 'bold').slice(0,1), x+18, statY+52);
  }
  function drawBadge(text, x, badgeY, fill, color){
    doc.setFillColor(fill);
    doc.roundedRect(x, badgeY, 84, 24, 12, 12, 'F');
    doc.setTextColor(color);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.text(text, x + 13, badgeY + 16);
  }

  pageBase(true); y = 150;
