<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
:root {
  --blue:   #4361EE;
  --orange: #FF6B35;
  --lime:   #C8FF00;
  --pink:   #FF3D8A;
  --white:  #FFFFFF;
  --off:    #F5F4FF;
  --dark:   #111118;
  --grey:   #6B6B80;
  --light:  #EDEDF7;
  --green:  #25D366;
}
 
body {
  font-family: 'DM Sans', sans-serif;
  background: var(--off);
  background-image: repeating-linear-gradient(-45deg, transparent, transparent 18px, rgba(67,97,238,0.045) 18px, rgba(67,97,238,0.045) 19px);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 0;
}

/* 🔙 Back to Portal Button */
.back-btn-float {
  position: fixed;
  top: 20px;
  left: 20px;
  background: var(--white);
  color: var(--dark);
  text-decoration: none;
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  font-size: 13px;
  padding: 10px 18px;
  border-radius: 50px;
  border: 2.5px solid var(--dark);
  box-shadow: 3px 3px 0 var(--dark);
  z-index: 2000;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
}
.back-btn-float:hover {
  transform: translate(-2px, -2px);
  box-shadow: 5px 5px 0 var(--blue);
  border-color: var(--blue);
  color: var(--blue);
}
@media (max-width: 600px) {
  .back-btn-float { top: 12px; left: 12px; padding: 8px 14px; font-size: 12px; }
}
 
#adOverlay {
  position: fixed; inset: 0; z-index: 1000;
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.6s ease;
}
 
.stage {
  --rust:   #E8522A; --rust2:  #FF7043; --cream:  #FFF8F3; --yellow: #FFD93D;
  --blue:   #4CC9F0; --green:  #06D6A0; --pink:   #FF6B9D; --purple: #A78BFA; --dark:   #2D2A26;
  width: 360px; height: 640px; position: relative; overflow: hidden;
  background: var(--cream); border-radius: 32px;
  box-shadow: 0 0 0 4px #fff, 0 0 0 8px var(--rust), 0 30px 80px rgba(232,82,42,.3), 0 50px 120px rgba(0,0,0,.2);
}
 
canvas#particles { position: absolute; inset: 0; z-index: 60; pointer-events: none; border-radius: 32px; }
.scene { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; z-index: 10; }
.scene.active { opacity: 1; pointer-events: auto; }
 
.s0 { background: var(--yellow); overflow: hidden; }
.s0 .dots-bg { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,255,255,.55) 2px, transparent 2px); background-size: 28px 28px; }
.hey-emoji { font-size: 72px; opacity: 0; transform: scale(0) rotate(-20deg); position: relative; z-index: 2; filter: drop-shadow(0 6px 0 rgba(0,0,0,.12)); }
.s0.active .hey-emoji { animation: bounceIn 0.4s cubic-bezier(0.175,0.885,0.32,1.275) 0.1s forwards; }
.hey-text { font-family: 'Fredoka One', cursive; font-size: 80px; line-height: 1; color: var(--dark); text-align: center; position: relative; z-index: 2; opacity: 0; transform: translateY(30px); text-shadow: 0 5px 0 rgba(0,0,0,.1); }
.s0.active .hey-text { animation: adSlideUp 0.35s ease 0.35s forwards; }
.hey-sub { font-size: 18px; font-weight: 800; color: var(--rust); letter-spacing: 1px; position: relative; z-index: 2; opacity: 0; transform: translateY(15px); margin-top: 10px; }
.s0.active .hey-sub { animation: adSlideUp 0.3s ease 0.6s forwards; }
.pill-row { display: flex; gap: 8px; position: relative; z-index: 2; margin-top: 20px; opacity: 0; }
.s0.active .pill-row { animation: adFadeIn 0.3s ease 0.85s forwards; }
.pill { background: #fff; border-radius: 50px; padding: 6px 14px; font-size: 12px; font-weight: 800; color: var(--dark); box-shadow: 0 3px 0 rgba(0,0,0,.1); }
 
.s1 { background: var(--cream); overflow: hidden; }
.s1::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgba(232,82,42,.08) 0%, transparent 70%); }
.cd-ring { width: 220px; height: 220px; border-radius: 50%; border: 8px solid rgba(232,82,42,.15); display: flex; align-items: center; justify-content: center; position: absolute; }
.cd-ring-inner { width: 170px; height: 170px; border-radius: 50%; background: var(--rust); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 0 #b33d1c, 0 12px 30px rgba(232,82,42,.4); opacity: 0; transform: scale(0); }
