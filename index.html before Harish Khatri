.btn { display: inline-block; width: 100%; padding: 14px 22px; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 800; border: 2.5px solid var(--dark); border-radius: 14px; cursor: pointer; text-align: center; text-decoration: none; letter-spacing: 0.3px; transition: transform 0.12s, box-shadow 0.12s; box-shadow: 4px 4px 0 var(--dark); margin-top: 10px; }
