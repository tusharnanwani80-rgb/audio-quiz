.question-text { font-family: 'Righteous', cursive; font-size: 17px; color: var(--dark); line-height: 1.5; margin-bottom: 20px; min-height: 60px; text-align: left; }
.godmode-diagram { max-width: 100%; height: auto; border: 3px solid var(--dark); border-radius: 12px; margin: 14px 0; box-shadow: 4px 4px 0 var(--dark); display: block; }

/* AUDIO Specific Styles */
.godmode-audio { width: 100%; margin: 18px 0 24px; border-radius: 12px; border: 3px solid var(--dark); box-shadow: 4px 4px 0 var(--dark); background: var(--off); outline: none; display: block; }
.question-has-audio { margin-bottom: 25px; }

.options-grid { display: flex; flex-direction: column; gap: 10px; text-align: left; }
.option { display: flex; align-items: center; gap: 12px; padding: 13px 16px; background: var(--white); border: 2.5px solid var(--dark); border-radius: 14px; cursor: pointer; font-size: 13px; font-weight: 700; color: var(--dark); box-shadow: 3px 3px 0 var(--dark); line-height: 1.4; transition: transform 0.12s, box-shadow 0.12s, background 0.15s, border-color 0.15s; animation: slideIn 0.3s cubic-bezier(.34,1.3,.64,1) backwards; }
@keyframes slideIn { from { opacity: 0; transform: translateX(-14px); } to { opacity: 1; transform: translateX(0); } }
.option:hover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 var(--blue); border-color: var(--blue); background: #F0F3FF; }
.option-letter { width: 30px; height: 30px; border-radius: 9px; background: var(--off); border: 2px solid var(--dark); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; flex-shrink: 0; font-family: 'Righteous', cursive; transition: background 0.15s, border-color 0.15s; }
.option.correct { background: #EAFFDA; border-color: #3DB838; box-shadow: 3px 3px 0 #3DB838; transform: none; }
.option.correct .option-letter { background: #3DB838; border-color: #3DB838; color: white; }
.option.wrong { background: #FFEAEA; border-color: var(--pink); box-shadow: 3px 3px 0 var(--pink); transform: none; }
.option.wrong .option-letter { background: var(--pink); border-color: var(--pink); color: white; }
.expl-box { display: none; margin-top: 16px; background: #FFFBE6; border: 2.5px solid var(--orange); border-radius: 14px; padding: 13px 16px; font-size: 13px; font-weight: 600; color: #6B4500; text-align: left; line-height: 1.6; box-shadow: 3px 3px 0 var(--orange); }
.expl-box.show { display: block; animation: popIn 0.3s cubic-bezier(.34,1.3,.64,1); }
.expl-tag { font-family: 'Righteous', cursive; color: var(--orange); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; display: block; margin-bottom: 4px; }
.score-block { margin: 10px 0 18px; }
.score-number { font-family: 'Righteous', cursive; font-size: 76px; color: var(--blue); line-height: 1; text-shadow: 4px 4px 0 var(--dark); }
.score-denom { font-size: 20px; font-weight: 800; color: var(--grey); }
.score-pct { display: inline-block; margin-top: 6px; font-size: 13px; font-weight: 800; padding: 4px 16px; border-radius: 50px; border: 2px solid var(--dark); box-shadow: 2px 2px 0 var(--dark); }
.fb-box { background: var(--off); border: 2.5px solid var(--dark); border-radius: 16px; padding: 16px; margin: 14px 0; box-shadow: 4px 4px 0 var(--dark); text-align: left; }
.fb-box .fb-emoji { font-size: 28px; margin-bottom: 6px; display: block; }
.fb-box strong { font-family: 'Righteous', cursive; font-size: 18px; color: var(--dark); display: block; margin-bottom: 4px; }
.fb-box p { font-size: 13px; color: var(--grey); margin: 0; font-weight: 600; line-height: 1.5; }

/* ═══════════════════════════════════
   VIBE CHECK BOX STYLES + WAVY BG
═══════════════════════════════════ */
.feedback-box { background: var(--white); border: 2.5px solid var(--dark); border-radius: 18px; padding: 22px 16px 18px; margin: 16px 0 4px; box-shadow: 4px 4px 0 var(--dark); position: relative; text-align: center; }

.vibe-bg-layer { position: absolute; inset: 0; border-radius: 15px; overflow: hidden; z-index: 0; pointer-events: none; }
.vibe-bg-layer .wave { position: absolute; left: 50%; top: 25%; width: 500px; height: 500px; margin-left: -250px; background: var(--vibe-color, var(--grey)); opacity: 0.12; border-radius: 40%; animation: vibeDrift 12s infinite linear; transition: background 0.4s ease; }
.vibe-bg-layer .wave:nth-child(2) { animation: vibeDrift 18s infinite linear reverse; opacity: 0.08; border-radius: 45%; top: 30%; }
.vibe-bg-layer .wave:nth-child(3) { animation: vibeDrift 24s infinite linear; opacity: 0.10; border-radius: 42%; top: 35%; }
@keyframes vibeDrift { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.feedback-question, .emoji-bar, .feedback-info-text { position: relative; z-index: 1; }

.feedback-title { display: inline-block; position: absolute; top: -13px; left: 16px; background: var(--orange); color: var(--white); border: 2px solid var(--dark); border-radius: 999px; padding: 4px 12px; font-family: 'Righteous', cursive; font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase; box-shadow: 2px 2px 0 var(--dark); z-index: 2 !important; }
.feedback-question { font-size: 15px; font-weight: 900; color: var(--dark); margin-bottom: 12px; }

.lottie-stack { position: relative; width: 100px; height: 100px; margin: 16px auto 8px; transform: scale(1.15); z-index: 1; }
.lottie-stack lottie-player { position: absolute; top: 0; left: 0; width: 100%; height: 100%; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); pointer-events: none; }
.emoji-bar { display: flex; justify-content: space-between; margin-top: 12px; padding: 0 4px; width: 100%; box-sizing: border-box; }
.mini-emoji { font-size: 24px; filter: grayscale(100%); opacity: 0.4; transition: all 0.3s; transform: scale(0.8); display: inline-block; }
.mini-emoji.active { filter: grayscale(0%); opacity: 1; transform: scale(1.3) translateY(-4px); }

.feedback-slider { -webkit-appearance: none; appearance: none; width: 100%; height: 12px; border-radius: 999px; background: var(--light); border: 2px solid var(--dark); outline: none; cursor: pointer; position: relative; z-index: 10; margin-top: 12px; }
.feedback-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 28px; height: 28px; border-radius: 8px !important; background: var(--white); border: 3px solid var(--dark); box-shadow: 2px 2px 0 var(--dark); transition: background 0.3s, transform 0.1s !important; }
.feedback-slider::-moz-range-thumb { width: 24px; height: 24px; border-radius: 8px !important; background: var(--white); border: 3px solid var(--dark); box-shadow: 2px 2px 0 var(--dark); transition: background 0.3s, transform 0.1s !important; }
.feedback-slider:disabled { cursor: default; opacity: 0.65; }
.feedback-slider:active::-webkit-slider-thumb { transform: scale(0.9) !important; }

.feedback-info-text { display: block; margin-top: 12px; color: var(--grey); font-size: 13px; font-weight: 900; letter-spacing: 0.4px; text-transform: uppercase; }
.feedback-info-text.is-saved { color: var(--green) !important; }
.vibe-label { font-family: 'Righteous', cursive; font-size: 16px !important; margin-top: 16px !important; text-transform: uppercase; letter-spacing: 1px; transition: color 0.3s; }

.divider { display: flex; align-items: center; gap: 12px; margin: 22px 0; color: var(--grey); font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }
.divider::before, .divider::after { content: ''; flex: 1; height: 2px; background: var(--light); border-radius: 2px; }
.rev-head { margin-bottom: 16px; }
.rev-head .r-emoji { font-size: 28px; margin-bottom: 8px; }
.rev-head h3 { font-family: 'Righteous', cursive; font-size: 22px; color: var(--dark); margin-bottom: 4px; }
.rev-head p { font-size: 12px; font-weight: 600; color: var(--grey); }
.sburst { position: absolute; font-size: 14px; pointer-events: none; animation: burstAnim 750ms forwards; }
@keyframes burstAnim { 0%{opacity:1;transform:translate(0,0) scale(1.3) rotate(0deg)} 100%{opacity:0;transform:translate(var(--bx),var(--by)) scale(0) rotate(180deg)} }
.hidden { display: none !important; }

/* ═══════════════════════════════════
   CHALLENGE A FRIEND STYLES
═══════════════════════════════════ */

/* ── Challenge Button ── */
.btn-challenge {
  background: linear-gradient(135deg, #7C3AED, #4361EE, #FF3D8A);
  background-size: 300% 300%;
  animation: challengeGradient 3s ease infinite;
  color: white;
  border: 2.5px solid var(--dark);
  position: relative;
  overflow: hidden;
}
@keyframes challengeGradient {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
.btn-challenge::before {
  content: '';
  position: absolute;
  top: -2px; left: -100%;
  width: 60%; height: calc(100% + 4px);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
  animation: challengeShimmer 2s linear infinite;
  border-radius: 14px;
}
@keyframes challengeShimmer { from { left: -60%; } to { left: 160%; } }

.btn-challenge:hover { transform: translate(-3px,-3px) scale(1.02); box-shadow: 6px 6px 0 var(--dark), 0 0 24px rgba(124,58,237,0.5); }
.btn-challenge:active { transform: translate(2px,2px); }

/* Floating particles on the challenge button */
.challenge-btn-wrap { position: relative; width: 100%; }
.challenge-btn-wrap .c-particle {
  position: absolute;
  width: 7px; height: 7px;
  border-radius: 50%;
  pointer-events: none;
  animation: cParticleFloat 2.5s ease-in-out infinite;
  opacity: 0;
}
.challenge-btn-wrap .c-particle:nth-child(1){ background:#C8FF00; top:-10px; left:15%; animation-delay:0s; }
.challenge-btn-wrap .c-particle:nth-child(2){ background:#FF3D8A; top:-14px; left:40%; animation-delay:0.4s; width:9px;height:9px; }
.challenge-btn-wrap .c-particle:nth-child(3){ background:#4CC9F0; top:-8px;  left:65%; animation-delay:0.8s; }
.challenge-btn-wrap .c-particle:nth-child(4){ background:#FFD93D; top:-12px; left:82%; animation-delay:1.2s; width:6px;height:6px; }
.challenge-btn-wrap .c-particle:nth-child(5){ background:#A78BFA; top:-10px; left:5%;  animation-delay:1.6s; }
@keyframes cParticleFloat {
  0%   { opacity:0; transform: translateY(0) scale(0.5); }
  30%  { opacity:1; transform: translateY(-14px) scale(1); }
  70%  { opacity:1; transform: translateY(-22px) scale(0.9); }
  100% { opacity:0; transform: translateY(-30px) scale(0.5); }
}

/* ── Challenge Button: Lottie + VS watermark ── */
