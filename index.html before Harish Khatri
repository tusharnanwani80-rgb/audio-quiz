class CrispParticle {
    constructor(x, y, baseColor) {
        this.x = x;
        this.y = y;
        
        const palette = [baseColor, baseColor, '#111827', '#ffffff'];
        this.color = palette[Math.floor(Math.random() * palette.length)];
        
        const shapes = ['circle', 'triangle', 'plus', 'line'];
        this.shape = shapes[Math.floor(Math.random() * shapes.length)];
        
        this.size = Math.random() * 6 + 4;
        
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 12 + 4;
        this.vx = Math.cos(angle) * speed;
        this.vy = Math.sin(angle) * speed - 6;
        
        this.gravity = 0.4;
        this.friction = 0.88;
        
        this.angle = Math.random() * Math.PI * 2;
        this.spin = (Math.random() - 0.5) * 0.4;
        
        this.scale = 1;
        this.scaleSpeed = Math.random() * 0.02 + 0.015;
    }
    
    update() {
        this.x += this.vx;
        this.y += this.vy;
        this.vy += this.gravity;
        this.vx *= this.friction;
        this.angle += this.spin;
        this.scale -= this.scaleSpeed;
    }
    
    draw() {
        if (this.scale <= 0) return;
        
        pCtx.save();
        pCtx.translate(this.x, this.y);
        pCtx.rotate(this.angle);
        pCtx.scale(this.scale, this.scale);
        
        pCtx.fillStyle = this.color;
        pCtx.strokeStyle = this.color;
        pCtx.lineWidth = 3.5;
        pCtx.lineCap = 'round';
        pCtx.lineJoin = 'round';
        
        pCtx.beginPath();
        if (this.shape === 'circle') {
            pCtx.arc(0, 0, this.size, 0, Math.PI * 2);
            pCtx.fill();
        } else if (this.shape === 'triangle') {
            pCtx.moveTo(0, -this.size);
            pCtx.lineTo(this.size, this.size);
            pCtx.lineTo(-this.size, this.size);
            pCtx.closePath();
            pCtx.fill();
        } else if (this.shape === 'plus') {
            pCtx.moveTo(-this.size, 0);
            pCtx.lineTo(this.size, 0);
            pCtx.moveTo(0, -this.size);
            pCtx.lineTo(0, this.size);
            pCtx.stroke();
        } else if (this.shape === 'line') {
            pCtx.moveTo(-this.size * 1.5, 0);
            pCtx.lineTo(this.size * 1.5, 0);
            pCtx.stroke();
        }
        
        pCtx.restore();
    }
}

function animateCrispParticles() {
    pCtx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
    crispParticles = crispParticles.filter(p => p.scale > 0);
    crispParticles.forEach(p => {
        p.update();
        p.draw();
    });
    requestAnimationFrame(animateCrispParticles);
}
animateCrispParticles();

