function playMilestoneChime(level) {
    const c = ac(); if(!c) return;
    try {
        const playTone = (f, type, time, dur) => {
            const o = c.createOscillator();
            const g = c.createGain();
            o.type = type;
            o.frequency.setValueAtTime(f, c.currentTime + time);
            g.gain.setValueAtTime(0.1, c.currentTime + time);
            g.gain.exponentialRampToValueAtTime(0.01, c.currentTime + time + dur);
            o.connect(g); g.connect(c.destination);
            o.start(c.currentTime + time);
            o.stop(c.currentTime + time + dur);
        };
        const baseFreq = 400 + (level * 25); 
        playTone(baseFreq, 'sine', 0, 0.1);
        playTone(baseFreq * 1.5, 'sine', 0.1, 0.2);
        if(level >= 10) playTone(baseFreq * 2, 'sine', 0.2, 0.4); 
    } catch(e) {}
}

function playDetonationSound() {
    const c = ac(); if(!c) return;
    try {
        const noiseBuf = c.createBuffer(1, c.sampleRate * 0.1, c.sampleRate);
        const output = noiseBuf.getChannelData(0);
        for (let i = 0; i < output.length; i++) output[i] = Math.random() * 2 - 1;
        const noiseSrc = c.createBufferSource();
        noiseSrc.buffer = noiseBuf;
        const noiseGain = c.createGain();
        noiseGain.gain.setValueAtTime(0.4, c.currentTime);
        noiseGain.gain.exponentialRampToValueAtTime(0.01, c.currentTime + 0.1);
        noiseSrc.connect(noiseGain); noiseGain.connect(c.destination);
        noiseSrc.start();

        const osc = c.createOscillator();
        const gain = c.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(150, c.currentTime); 
        osc.frequency.exponentialRampToValueAtTime(10, c.currentTime + 1.2); 
        gain.gain.setValueAtTime(0.5, c.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, c.currentTime + 1.2); 
        osc.connect(gain); gain.connect(c.destination);
        osc.start(); osc.stop(c.currentTime + 1.3);
    } catch(e) {}
}

