    }
    
    for(let asset of expImages) {
      drawImageContain(asset, textX + textW/2, rowY + maxImgH/2, textW, maxImgH);
      rowY += maxImgH + 12;
    }

    y += boxH + 16;
  }

  drawFootersAndWatermark();
  doc.save(fileName || 'TTC_Quiz_Report.pdf');
}

async function loadPdfAssets(){
  const entries = await Promise.all([charPngAsset(), imageToAsset(TTC_ASSETS.sai)]);
  return { logo: entries[0], sai: entries[1] };
}

async function charPngAsset(){
  try {
    const im = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = TTC_ASSETS.char; });
    const c = document.createElement('canvas'); c.width = im.naturalWidth; c.height = im.naturalHeight;
    c.getContext('2d').drawImage(im, 0, 0);
    return { data: c.toDataURL('image/png'), width: c.width, height: c.height, type: 'PNG' };
  } catch(e) { return null; }
}

async function imageToAsset(url){
  try {
    const res = await fetch(url, { mode: 'cors', cache: 'force-cache' });
    if(!res.ok) throw new Error('Image failed');
    const blob = await res.blob();
    const data = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
    const size = await new Promise(resolve => {
      const img = new Image();
      img.onload = () => resolve({ width: img.naturalWidth || 1, height: img.naturalHeight || 1 });
      img.onerror = () => resolve({ width: 1, height: 1 });
      img.src = data;
    });
    return { data, width: size.width, height: size.height, type: blob.type && blob.type.includes('png') ? 'PNG' : 'JPEG' };
  } catch(e) {
    return null;
  }
}
 
