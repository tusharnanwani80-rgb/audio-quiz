let lastVibeVal = 2;
function updateQuizFeedbackUI(saved){
  const slider = document.getElementById("quizFeedbackSlider");
  const text = document.getElementById("quizFeedbackText");
  const stack = document.getElementById("lottieStack");
  const miniBar = document.getElementById("miniEmojiBar");
  if (!slider || !text) return;

  const idx = Math.max(0, Math.min(4, parseInt(slider.value || "2", 10)));
  const activeColor = feedbackColors[idx];

  const fBox = document.getElementById('resultFeedbackBox');
  if(fBox) fBox.style.setProperty('--vibe-color', activeColor);

  if (stack) {
      stack.querySelectorAll('lottie-player').forEach(player => {
          const isMatch = parseInt(player.dataset.idx) === idx;
          player.style.opacity = isMatch ? '1' : '0';
          player.style.transform = isMatch ? 'scale(1)' : 'scale(0.5)';
          if (isMatch && idx !== lastVibeVal && !saved) player.seek(0);
      });
  }

  if (miniBar) {
      miniBar.querySelectorAll('.mini-emoji').forEach((emoji, eIdx) => {
          if (eIdx === idx) emoji.classList.add('active');
          else emoji.classList.remove('active');
      });
  }

  text.innerText = saved ? "Saved: " + feedbackLabels[idx] : feedbackLabels[idx];
  text.style.color = saved ? "var(--green)" : activeColor;
  text.classList.toggle("is-saved", !!saved);

  if (idx !== lastVibeVal && !saved) {
      lastVibeVal = idx;
      if (stack) {
          const rect = stack.getBoundingClientRect();
          createBurst(rect.left + rect.width / 2, rect.top + rect.height / 2, activeColor);
      }
  }
}

