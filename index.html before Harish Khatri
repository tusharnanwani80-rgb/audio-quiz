    doc.setTextColor(colors.ink);
    doc.setFontSize(13);
    doc.text(qLines, textX, y + 58);
    
    let rowY = y + 66 + qLines.length * 16;
    
    for(let asset of qImages) {
      drawImageContain(asset, textX + textW/2, rowY + maxImgH/2, textW, maxImgH);
